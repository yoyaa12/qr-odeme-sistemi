# Bu dosyayı ".env" olarak kopyalayıp değerleri kendinize göre doldurun.
# ".env" dosyası .gitignore ile takip dışıdır, asla commit edilmemelidir.

# --- MS SQL Server 2022 Bağlantı Ayarları ---
DB_SERVER=.\SQLEXPRESS
DB_NAME=RestoranQRDB
# Windows kimlik doğrulaması kullanılıyorsa DB_USER / DB_PASSWORD boş bırakılır.
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=yes

# --- Uygulama ---
PORT=8000

# --- Kimlik Doğrulama (ZORUNLU) ---
# Personel JWT'lerinin imzalanmasında kullanılır. Tanımlı değilse veya
# 32 bayttan kısaysa uygulama açılışta hata verir (app/auth/tokens.py).
# Rastgele bir değer üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Personel access token ömrü (saniye). İsteğe bağlı.
# Varsayılan: 2592000 (30 gün). İzin verilen aralık: 60 - 31536000
AUTH_STAFF_TOKEN_TTL_SECONDS=2592000
